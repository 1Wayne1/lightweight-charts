{
	"name": "@tradingview/lwc-plugin-drawing-tools",
	"version": "1.0.0",
	"description": "TradingView-style interactive drawing tools suite for Lightweight Charts (trend line, ray, horizontal/vertical lines, rectangle, parallel channel, Fibonacci retracement, price/date range ruler, text annotation) with left toolbar and floating properties bar UI.",
	"author": "TradingView",
	"license": "Apache-2.0",
	"type": "module",
	"types": "./dist/drawing-tools.d.ts",
	"exports": {
		".": {
			"types": "./dist/drawing-tools.d.ts",
			"default": "./dist/drawing-tools.js"
		},
		"./standalone": {
			"types": "./dist/drawing-tools.d.ts",
			"default": "./dist/drawing-tools.standalone.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"keywords": [
		"lightweight-charts",
		"lightweight-charts-plugin",
		"lwc-plugin",
		"drawing-tools",
		"line-tools",
		"fibonacci",
		"technical-analysis"
	],
	"scripts": {
		"dev": "vite --config src/vite.config.js",
		"build": "tsc && node compile.mjs",
		"typecheck": "tsc --noEmit",
		"test": "node --test tests/*.test.ts"
	},
	"peerDependencies": {
		"lightweight-charts": "^5.0.0"
	},
	"dependencies": {
		"fancy-canvas": "~2.1.0"
	},
	"devDependencies": {
		"@tradingview/lwc-toolkit": "workspace:*",
		"dts-bundle-generator": "9.5.1",
		"lightweight-charts": "workspace:*",
		"typescript": "5.9.3",
		"vite": "8.3.7"
	},
	"lwcPlugin": {
		"title": "Drawing tools",
		"category": "series-primitive",
		"lifecycle": "current",
		"origin": "community",
		"demo": "src/example/index.html",
		"tags": [
			"drawing",
			"trend line",
			"ray",
			"rectangle",
			"parallel channel",
			"fibonacci",
			"ruler",
			"text"
		]
	}
}
