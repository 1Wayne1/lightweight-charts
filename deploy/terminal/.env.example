# Generate a unique single-user access token, for example: openssl rand -hex 24
SYNC_TOKEN=
# Bind 127.0.0.1 behind an HTTPS reverse proxy on public servers, or 0.0.0.0 on trusted LAN
SYNC_BIND=127.0.0.1
SYNC_PORT=8080
# Host directory where terminal.db is stored (portable single SQLite database)
DATA_DIR=./data
# Allowed browser origin for cross-origin sync requests (default * for dev/LAN)
CORS_ORIGIN=*
