# Generate a unique single-user access token, for example: openssl rand -hex 24
SYNC_TOKEN=
# Bind 127.0.0.1 behind an HTTPS reverse proxy on public servers, or 0.0.0.0 on trusted LAN
SYNC_BIND=127.0.0.1
SYNC_PORT=8080
# Host directory where terminal.db is stored (portable single SQLite database)
DATA_DIR=./data
# Allowed browser origin for cross-origin sync requests (default * for dev/LAN)
CORS_ORIGIN=*
# Optional HTTP(S) proxy used by the server to relay Binance REST & WebSocket (e.g. http://127.0.0.1:7890 on PC)
# MARKET_PROXY_URL=http://127.0.0.1:7890
# Optional upstream Binance endpoint overrides for the server-side market relay
# BINANCE_SPOT_REST=https://data-api.binance.vision
# BINANCE_PERPETUAL_REST=https://fapi.binance.com
# BINANCE_SPOT_WS=wss://data-stream.binance.vision
# BINANCE_PERPETUAL_WS=wss://fstream.binance.com/market
